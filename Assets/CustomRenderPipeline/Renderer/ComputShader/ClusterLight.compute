
#include "../ShaderLibrary/Common.hlsl"

#pragma multi_compile _ UNITY_REVERSED_Z

#pragma multi_compile _ VISABLE_LIGHT_COUNT

struct OtherLight
{
	float4 lightColor;
	float4 lightPosition;
	float4 lightDirectionsAndMasks;
	float4 lightSpotAngles;
	float4 lightShadowData;
	// 面光源：两条半轴（已乘半宽/半高）。lightAreaRight.w = 半宽，> 0 即为面光源。
	// ⚠️ 必须与 Light.hlsl / Lighting.cs 的字段顺序逐字一致。
	float4 lightAreaRight;
	float4 lightAreaUp;
};

#pragma kernel LightCluster


#define MAX_LIGHT_COUNT_PER_TILE 32
#define THREAD_NUM_X 16
#define THREAD_NUM_Y 16
#define THREAD_COUNT 256

groupshared uint tileMinDepthInt = 0xFFFFFFFF;		//整型化的最小深度
groupshared uint tileMaxDepthInt = 0;				//最大深度

groupshared	float4 debug;

groupshared uint tileVisibleLightCount = 0;			//该tile的灯光数量，使用线程操作保证一个tile一个tile的执行
// 只需容纳「每 tile 输出上限」那么多，不再是原始灯数（省 896B groupshared，直接提升占用率）
groupshared uint tileVisibleLightIndices[MAX_LIGHT_COUNT_PER_TILE];

float4x4 _CameraMatrixV;
float4 _DeferredTileParams;

//近平面左下角
uniform float3 _CameraNearPlaneLB;
//近平面水平基向量
uniform float3 _CameraNearBasisH;
//近平面垂直基向量
uniform float3 _CameraNearBasisV;

Texture2D<float> _GBufferDepthTex;       //深度图
uint _OtherLightCount;
StructuredBuffer<OtherLight> _OtherLightBuffer;

RWStructuredBuffer<uint> _RWTileLightsArgsBuffer;
RWStructuredBuffer<uint> _RWTileLightsIndicesBuffer;

RWTexture2D<float4> _OutTexture;

inline float LinearEyeDepth( float z )
{
    return (1.0 / (_ZBufferParams.z * z + _ZBufferParams.w));
}

//aabb.xy为中心,aabb.zw为extents
bool IntersectAABB(float4 aabb,float4 lightSphere){
    float2 p = aabb.xy + aabb.zw * sign(lightSphere.xy - aabb.xy);
    float2 d = p - lightSphere.xy;
    return dot(d,d) < lightSphere.w * lightSphere.w;
}

bool Intersect(float3 tileFrustumCorners[4], OtherLight otL){
    float tileDepthMin = asfloat(tileMinDepthInt);
    float tileDepthMax = asfloat(tileMaxDepthInt);


	float3 lightCamPos = mul(_CameraMatrixV, float4(otL.lightPosition.xyz,1)).xyz;//转到CameraView坐标系
    float lightRadius = otL.lightColor.w;
    float lightDepthMin = -lightCamPos.z - lightRadius;
    float lightDepthMax = -lightCamPos.z + lightRadius;

	// debug = float4(tileDepthMax, tileDepthMin, lightDepthMax, lightDepthMin) / 100.0



    if(lightDepthMin > tileDepthMax || lightDepthMax < tileDepthMin){
        return false;
    }

	float minZ = max(tileDepthMin,lightDepthMin);
	float maxZ = min(tileDepthMax,lightDepthMax);
	float farPlaneScale = maxZ / tileDepthMin;
	float nearPlaneScale = minZ / tileDepthMin;
	float2 minXY = tileFrustumCorners[0].xy;
	float2 maxXY = tileFrustumCorners[2].xy;
	minXY = min(minXY * nearPlaneScale ,minXY * farPlaneScale);
	maxXY = max(maxXY * nearPlaneScale ,maxXY * farPlaneScale);
	float4 aabb = float4((minXY + maxXY) * 0.5,(maxXY - minXY) * 0.5);

	if (!IntersectAABB(aabb, float4(lightCamPos, otL.lightColor.w))) return false;

	// ---------- 面光源：再切一刀「发光面正前方那个半球」 ----------
	// 光照模型里 sideAttenuation = saturate(dot(发光面法线, normalize(P-中心)) * 3)，
	// dot ≤ 0 的地方【恒为 0】⇒ 整个 tile AABB 落在发光面背后时，可以整块剔掉，
	// 严格精确、不会漏灯（不是近似）。
	// 这一刀对「贴天花板 / 贴墙的面光源」特别值：原来的球测试会把灯背后那半张图的
	// tile 全算进来，白遍历一遍灯。
	// 空间约定：tileFrustumCorners 与 lightCamPos 的 xy 同口径（右·上，来自 worldToCameraMatrix），
	// 但深度侧统一用「+z 朝前」（见 -lightCamPos.z 与 minZ/maxZ），所以法线的 z 要取反。
	if (otL.lightAreaRight.w > 0.0) {
		float3 emitDirWS = -otL.lightDirectionsAndMasks.xyz;   // 世界空间：发光面外法线
		float3 n = mul((float3x3)_CameraMatrixV, emitDirWS);
		n.z = -n.z;                                            // 转到「+z 朝前」口径

		float3 lo = float3(aabb.xy - aabb.zw, minZ);
		float3 hi = float3(aabb.xy + aabb.zw, maxZ);
		float3 farthest = lerp(lo, hi, step(0.0, n));          // 沿 n 方向最远的那个角
		float3 lightCenter = float3(lightCamPos.xy, -lightCamPos.z);
		if (dot(n, farthest - lightCenter) <= 0.0) return false;
	}
	return true;
}



[numthreads(THREAD_NUM_X, THREAD_NUM_Y, 1)]
void LightCluster(uint3 id : SV_DispatchThreadID,uint3 groupId:SV_GROUPID, uint groupIndex:SV_GROUPINDEX){

    //stage 1. 初始化groupshared变量
    if(groupIndex == 0){
        tileMinDepthInt = 0xFFFFFFFF;
        tileMaxDepthInt = 0;
        tileVisibleLightCount = 0;
        // gemoDepthMask = 0;

    }

	//阻止线程的运行，直到该tile的每一个都执行到这里为止
    GroupMemoryBarrierWithGroupSync();

    bool inScreen = (float)id.x < _CameraBufferSize.x && (float)id.y < _CameraBufferSize.y;
	float depth = 0;
    float linearDepth = 0;
    if(inScreen){
        depth = _GBufferDepthTex[id.xy].r;
        #if UNITY_REVERSED_Z
        linearDepth = LinearEyeDepth(1 - depth);
        #else
        linearDepth = LinearEyeDepth(depth);
        #endif
        //找最小值
        InterlockedMin(tileMinDepthInt, asuint(linearDepth));
        //找最大值
        InterlockedMax(tileMaxDepthInt, asuint(linearDepth));

    }
    //上面一轮后可以得到1个tile中的像素最小/大值
    GroupMemoryBarrierWithGroupSync();

    float tileDepthMin = asfloat(tileMinDepthInt);
    float tileDepthMax = asfloat(tileMaxDepthInt);

    // 16x16 = 256 线程，每个线程负责「若干盏灯」（跨步循环），不再是一线程一盏
    uint2 tileId = groupId.xy;
    
    float tileDepthMinScale = tileDepthMin / _ProjectionParams.y; //_ProjectionParams.y is nearPlaneZ
    float3 tileFrustumCorners[4];
    tileFrustumCorners[0] = tileDepthMinScale * (_CameraNearPlaneLB + tileId.x * _CameraNearBasisH + tileId.y * _CameraNearBasisV);
    tileFrustumCorners[1] = tileFrustumCorners[0] + _CameraNearBasisH * tileDepthMinScale;
    tileFrustumCorners[2] = tileFrustumCorners[0] + (_CameraNearBasisH + _CameraNearBasisV) * tileDepthMinScale;
    tileFrustumCorners[3] = tileFrustumCorners[0] + _CameraNearBasisV * tileDepthMinScale;

	// 剔除：每线程按下标跨步遍历【所有】可见灯。
	// 旧写法是「lightIndex = groupIndex，只测这一盏」，等于把灯数硬绑在 256（线程数）上：
	//   · 超过 256 盏的灯永远不参与剔除（静默丢光）；
	//   · 灯少时又白跑 256 个线程的空分支。
	// 跨步循环是 tiled deferred 的标准写法：灯少时只跑 1 圈，灯多时自动多跑几圈，
	// 完全不受线程数限制。HLSL 里用 [loop] 明确告诉编译器别展开。
	[loop]
	for (uint lightIndex = groupIndex; lightIndex < _OtherLightCount; lightIndex += THREAD_COUNT){
		OtherLight otL = _OtherLightBuffer[lightIndex];
		if(Intersect(tileFrustumCorners, otL)){
			uint offset = 0;
			//原子方式添加值，记录组内有多少灯光
			InterlockedAdd(tileVisibleLightCount,1,offset);
			// ⚠️ groupshared 只有 32 格：超了必须丢弃（只丢最弱的那些，不影响正确性），
			// 绝不能越界写 —— 旧代码没有这个判断，tile 内 >256 盏灯时会踩坏别的 groupshared 变量。
			if(offset < (uint)MAX_LIGHT_COUNT_PER_TILE){
				tileVisibleLightIndices[offset] = lightIndex;
			}
		}
	}
    GroupMemoryBarrierWithGroupSync();

#if VISABLE_LIGHT_COUNT

_OutTexture[id.xy] = tileVisibleLightCount / (float)_OtherLightCount;

#endif

    uint tileIndex = tileId.y * _DeferredTileParams.z + tileId.x;
    if(groupIndex == 0){
        // ⚠️ 必须 clamp：indices 只写了前 32 盏，若这里写原始计数（可能 > 32），
        // 光照 pass 会按计数读到【相邻 tile】的灯索引 ⇒ 莫名其妙的光照串台。
        // ⚠️ 必须显式转 uint：min(uint, 32) 在 HLSL 里是 "ambiguous function call"（编译失败）
        _RWTileLightsArgsBuffer[tileIndex] = min(tileVisibleLightCount, (uint)MAX_LIGHT_COUNT_PER_TILE);
    }

    if(groupIndex < tileVisibleLightCount && groupIndex < MAX_LIGHT_COUNT_PER_TILE){
        uint visibleLightIndex = tileVisibleLightIndices[groupIndex];		//取出其中任意一盏灯
        _RWTileLightsIndicesBuffer[tileIndex * MAX_LIGHT_COUNT_PER_TILE + groupIndex] = visibleLightIndex;
    }
}
