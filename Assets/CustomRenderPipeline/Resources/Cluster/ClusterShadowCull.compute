// 【cluster 管线】阴影用的逐簇 GPU 剔除。
//
// 一次 dispatch 剔完【所有级联】：
//   Reset    （1 组，清零计数器）
//   CullAll  （每簇一线程，内部循环所有级联做球-平面视锥剔除，可见簇原子追加进 _Visible）
//   BuildArgs（每级联一线程，写 indirect args）
// ⇒ 整帧 3 个 dispatch + 每级联 1 次间接绘制。级联被压进 shader 内循环，而非每级联一次 dispatch。
//
// 数据链路：CullAll 产出每级联的可见槽位表 _SlotOf（不可见 = 0xFFFFFFFF），
// BuildIndices 再把【可见】簇的全局顶点号铺进索引缓冲 _DrawIdx；
// 绘制时 shader 的 VS 直接 _Positions[SV_VertexID] —— 一次顺序读取，无任何查表。
//
// 为什么要建真索引（2026-10-28 定案，与 GBuffer 同一套）：
//   静态单位索引缓冲 [0,1,2,...] 每个索引只用一次 ⇒ GPU 顶点缓存零复用，
//   一个 128 三角形的簇唯一顶点只有约 66 个，却要跑 384 次 VS（约 5.8 倍）。
//   ⚠️ 只对【可见】簇建索引：写量 = 可见簇数 × 384 × 级联数。按全部簇建会到上百 MB
//      （上一版就是写 188MB、compute 反烧 1.6ms 而失败）。
//   ⚠️ dispatch 规模必须跟实际量走：一维展开 + _SlotOf 早退，别按上界开方阵。
//
// 剔除口径：每级联 worldToClip = GL.GetGPUProjectionMatrix(proj,true)*view（与绘制侧逐位一致），
// 用其 6 个世界空间视锥平面与簇包围球做球-平面测试，不漏不重。
// 坑：裸 proj*view 在 D3D reversed-Z 下近/远平面算反 ⇒ 过剔除；cullingSphere 球-球测试是级联内含球 ⇒ 漏四角。
#pragma kernel Reset
#pragma kernel CullAll
#pragma kernel BuildArgs
#pragma kernel BuildIndices
#pragma kernel CopyStatic

StructuredBuffer<float4> _ClusterBounds;         // xyz=世界包围球中心 w=半径

// 每级联 6 个世界空间视锥平面（来自 GeometryUtility.CalculateFrustumPlanes(worldToClip)）。
// worldToClip 与绘制侧 GL.GetGPUProjectionMatrix(proj,true)*view 逐位一致。
StructuredBuffer<float4> _Planes;   // 长度 = maxCascade * 6
// [簇 × 384] = 该角点对应的全局顶点号（重建期烘死，静态）
StructuredBuffer<int>    _CornerGvid;

RWStructuredBuffer<uint> _Visible;                // [cascade * _ClusterCount + slot] = 簇下标（可见簇的紧凑列表）
// [cascade * _ClusterCount + 簇] = 该簇在本级联的可见槽位；不可见写 0xFFFFFFFF。
// BuildIndices 靠它早退，索引缓冲才只需要覆盖「场景总簇数」而不是「组数 × 上界」。
RWStructuredBuffer<uint> _SlotOf;
RWStructuredBuffer<uint> _Counter;                // [cascade] = 该级联可见簇数
RWStructuredBuffer<uint> _Args;                   // [cascade * 5 + 0..4] = 索引间接绘制 args

// 索引缓冲本体：GraphicsBuffer 用 Target.Index | Target.Raw 创建，
// 既能当 index buffer 读、又能当 UAV 写 ⇒ compute 直接写、draw 直接用，单缓冲零拷贝。
RWByteAddressBuffer      _DrawIdx;

int _CascadeCount;
int _ClusterCount;
int _TrisPerCluster;
int _DebugForceAll;                              // 非 0 = 跳过所有剔除，全可见（排查用）
int _IdxDimX;                                    // BuildIndices 的 x 维线程数（= 组数 × 64）
// 可见率阈值（百分比）：某级联可见簇数 ≥ 总簇数 × 该值% 时，直接画【静态全量段】，
// 完全跳过 BuildIndices 的重排。多画的那几个不可见簇已被视锥剔过 ⇒ 影子落不进本级联盒内
// ⇒ 视觉上无害，只是多走点几何；换掉的是整整 49MB/级的索引写入。
int _FullSkipPercent;

// 纯清零：dispatch 1 组即可
[numthreads(64, 1, 1)]
void Reset(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x < _CascadeCount) _Counter[id.x] = 0;
}

[numthreads(64, 1, 1)]
void CullAll(uint3 id : SV_DispatchThreadID)
{
    uint c = id.x;
    if ((int)c >= _ClusterCount) return;

    // 同一份包围球只读一次，循环所有级联 ⇒ 这就是「剔一次拿到全部级联的可见列表」
    float4 bb = _ClusterBounds[c];
    float3 center = bb.xyz;
    float radius = bb.w;

    for (int k = 0; k < _CascadeCount; k++)
    {
        _SlotOf[k * _ClusterCount + c] = 0xFFFFFFFFu;   // 先当不可见，顺手清掉上帧残留

        bool ok = true;

        if (_DebugForceAll == 0)
        {
            // 视锥平面剔除（球-平面）：簇包围球 vs 该级联 8 个世界空间平面
            // （前 6 个 = 视锥；后 2 个 = 光轴 z 的两个边界，补 CalculateFrustumPlanes
            //   在 reversed-Z 下"深度方向不剔"的漏洞 ⇒ 剔掉必然被光栅化器整块裁掉的簇）。
            // 平面约定（Unity Plane）：xyz=法线(指向视锥内)，w=到原点带符号距离；
            // 球在视锥内 ⇔ 对全部平面 dot(pl.xyz, center)+pl.w >= -radius。
            bool outside = false;
            for (int p = 0; p < 8; p++)
            {
                float4 pl = _Planes[k * 8 + p];
                if (dot(pl.xyz, center) + pl.w < -radius) { outside = true; break; }
            }
            if (outside) ok = false;
        }

        if (!ok) continue;

        // 原子追加进该级联的紧凑列表
        uint slot;
        InterlockedAdd(_Counter[k], 1u, slot);
        if ((int)slot < _ClusterCount)
        {
            _Visible[k * _ClusterCount + (int)slot] = c;
            _SlotOf[k * _ClusterCount + c] = slot;
        }
    }
}

// 每线程一个 (簇, 角点)，线程内循环所有级联 ——
// _CornerGvid[idx] 对 4 个级联是同一个值，读一次就够。
// dispatch = ceil(总簇数 × 384 / 64)，与级联数无关。
// 【静态段直通】某级联被 BuildArgs 判定为「可见率足够高」（_Args[k*5+2] == 0）时直接跳过：
//   那一级联的 draw 会去画 _DrawIdx 的【段 0 = 静态全量副本】，不需要任何重排。
//   这是目前省掉的最大一笔写入（实测每级 48.9MB，4 级合计 195MB）。
// ⚠️【试过并回退】dispatch 加 z 维=级联（线程数 ×4，无循环）：实测 ClusterCull 0.490 → 0.879ms。
//    4892 万线程的调度开销远超串行循环的延迟 ⇒ "多派线程早退出"在这里不成立。保持循环。
// ⚠️【试过并回退】numthreads(384)（每簇一组，组数 ÷6）：12 warp/组压垮 occupancy，0.475 → 0.547。
// ⚠️ D3D11 单维最多 65535 个线程组 ⇒ 二维拆开，用 _IdxDimX 把 (x,y) 拼回一维。
[numthreads(64, 1, 1)]
void BuildIndices(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.y * (uint)_IdxDimX + id.x;
    uint perCluster = (uint)(_TrisPerCluster * 3);
    if ((int)idx >= _ClusterCount * (int)perCluster) return;

    uint c      = idx / perCluster;
    uint corner = idx - c * perCluster;
    uint gvid   = (uint)_CornerGvid[idx];

    for (int k = 0; k < _CascadeCount; k++)
    {
        // 本段起点由 BuildArgs 决定：0 = 走静态全量段（无需重排），否则是压实段的起点。
        // 所以 BuildArgs 必须排在本 kernel 之前 dispatch。
        uint base = _Args[k * 5 + 2];
        if (base == 0u) continue;

        uint slot = _SlotOf[k * _ClusterCount + c];
        if (slot == 0xFFFFFFFFu) continue;

        uint dst = (base + slot * perCluster + corner) * 4u;
        _DrawIdx.Store(dst, gvid);
    }
}

// 把全量索引 [_CornerGvid] 复制到 _DrawIdx 的【段 0】。
// 只在 Rebuild 后跑一次（静态数据，之后永远不变）——可见率高的级联每帧直接画这一段，
// 等价于「Unity 用 mesh 自带静态索引」：一次都不用重排。
// 段布局：段 0 = 静态全量；段 (k+1) = 级联 k 的压实段。总长 = (级联上限+1) × 一份全量。
[numthreads(64, 1, 1)]
void CopyStatic(uint3 id : SV_DispatchThreadID)
{
    uint i = id.y * (uint)_IdxDimX + id.x;
    if ((int)i >= _ClusterCount * (int)(_TrisPerCluster * 3)) return;
    _DrawIdx.Store(i * 4u, (uint)_CornerGvid[i]);
}

// 每线程一个级联：把计数翻译成【索引间接绘制】的 indirect args（5 个 uint）。
//   [0]=indexCount(本级联可见簇 × 每簇 384 索引)
//   [1]=instanceCount（固定 1：单实例，索引缓冲已内含全部可见簇）
//   [2]=startIndexLocation  [3]=baseVertexLocation  [4]=startInstanceLocation
// 索引缓冲由 BuildIndices 按【可见】簇铺好，值就是全局顶点号 ⇒ VS 直接 _Positions[SV_VertexID]。
[numthreads(8, 1, 1)]
void BuildArgs(uint3 id : SV_DispatchThreadID)
{
    uint k = id.x;
    if ((int)k >= _CascadeCount) return;

    uint perCluster = (uint)_TrisPerCluster * 3u;
    uint oneCopy    = (uint)_ClusterCount * perCluster;   // 一份全量索引（= 静态段长度）
    uint cnt        = _Counter[k];

    // 可见率够高 ⇒ 直接画静态全量段（段 0），跳过本级的索引重排。
    // 正确性：被剔掉的簇 x/y 落不到本级联盒内 ⇒ 其影子也落不进盒内 ⇒ 多画它们视觉无害。
    bool full = (cnt * 100u >= (uint)_ClusterCount * (uint)_FullSkipPercent);

    _Args[k * 5 + 0] = full ? oneCopy : cnt * perCluster;      // indexCount
    _Args[k * 5 + 1] = 1;                                     // instanceCount
    _Args[k * 5 + 2] = full ? 0u : oneCopy * (k + 1u);         // startIndexLocation
    _Args[k * 5 + 3] = 0;                                     // baseVertexLocation
    _Args[k * 5 + 4] = 0;                                     // startInstanceLocation
}
